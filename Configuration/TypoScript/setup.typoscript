lib.contentElement {
  templateRootPaths.1722340760 = EXT:typo3_styleguide/Resources/Private/Templates/
  partialRootPaths.1722340760 = EXT:typo3_styleguide/Resources/Private/Partials/
}
tt_content {
  typo3styleguide_technicalheadline =< lib.contentElement
  typo3styleguide_technicalheadline {
    templateName = TechnicalHeadline
  }

  typo3styleguide_colors =< lib.contentElement
  typo3styleguide_colors {
    templateName = Colors
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
      table = tx_typo3styleguide_color
      pidInList.field = pid
      where = parentid=###uid### AND parenttable='tt_content'
      markers.uid.field = uid
      orderBy = sorting
      as = colors
    }
  }

  typo3styleguide_fonts =< lib.contentElement
  typo3styleguide_fonts {
    templateName = Fonts
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
      table = tx_typo3styleguide_font
      pidInList.field = pid
      where = parentid=###uid### AND parenttable='tt_content'
      markers.uid.field = uid
      orderBy = sorting
      as = fonts
    }
  }

  typo3styleguide_icons =< lib.contentElement
  typo3styleguide_icons {
    templateName = Icons
  }

  typo3styleguide_images =< lib.contentElement
  typo3styleguide_images {
    templateName = Images
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
      table = tx_typo3styleguide_image
      pidInList.field = pid
      where = parentid=###uid### AND parenttable='tt_content'
      markers.uid.field = uid
      orderBy = sorting
      as = images
    }
  }

  typo3styleguide_gallery =< lib.contentElement
  typo3styleguide_gallery {
    templateName = Gallery
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
    dataProcessing.10 {
      references.fieldName = tx_typo3styleguide_gallery_images
      as = images
    }
  }

  typo3styleguide_guidelines =< lib.contentElement
  typo3styleguide_guidelines {
    templateName = Guidelines
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
      table = tx_typo3styleguide_guideline
      pidInList.field = pid
      where = parentid=###uid### AND parenttable='tt_content'
      markers.uid.field = uid
      orderBy = sorting
      as = guidelines
    }
  }

  typo3styleguide_elementdoc =< lib.contentElement
  typo3styleguide_elementdoc {
    templateName = ElementDoc
    dataProcessing.10 = MoveElevator\Styleguide\DataProcessing\ElementDocProcessor
  }

  typo3styleguide_tableofcontents =< lib.contentElement
  typo3styleguide_tableofcontents {
    templateName = TableOfContents
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
    dataProcessing.10 {
      special = directory
      special.value.data = TSFE:id
      levels = 9
      includeSpacer = 1
      as = pages
      expandAll = 1
    }
  }
}

page.meta.robots = noindex,nofollow
page.meta.robots.if {
  value.data = page:doktype
  isInList = 1754310721
}

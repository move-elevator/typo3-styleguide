plugin.tx_typo3styleguide.frame {
  # Where the styleguide sits in the page tree. The site root is level 0, so a start page directly below it is level 1
  rootLevel = 1
  # Menu entry levels, which count from 0: the sections in the header and the pages in the side menu
  sectionEntryLevel = 1
  pageEntryLevel = 2
  # How many levels of the page tree the side menu shows below the section, for example 3 for pages, groups and the pages of the groups
  sideMenuLevels = 2
  # Deepest heading level (2 to 4) that the side menu lists below the active page, for example 2 to leave out the h3 headings
  sideMenuHeadingLevel = 4
  # Comma-separated columns (colPos) whose content elements are shown in the main area, in this order
  colPos = 0
  brand = Styleguide
  # Optional logo instead of the brand text, and the logo for the dark theme. EXT: paths
  logo =
  logoDark =
}

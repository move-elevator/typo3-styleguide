# Building blocks for a project that renders its pages with its own template (PAGEVIEW): the menus, the stylesheet and the partials.
# The project places the frame in its own layout, see the Frame section of the README
@import 'EXT:typo3_styleguide/Configuration/TypoScript/Frame/DataProcessing.typoscript'

page {
  includeCSS.typo3styleguideFrame = EXT:typo3_styleguide/Resources/Public/Css/Frame.css
  10.paths.1761600000 = EXT:typo3_styleguide/Resources/Private/Frame/
}

# The page preview element shows a page without the frame around it, the Chrome partial leaves it out for this variable
[traverse(request.getQueryParams(), 'sg_page_preview')]
  page.10.variables.styleguideBare = TEXT
  page.10.variables.styleguideBare.value = 1
[END]
